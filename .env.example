# =============================================================================
# Clarios Energy - environment template
#
# Copy to `.env` and adjust. `.env` is gitignored and must never be committed.
#
#   cp .env.example .env
#
# Every variable below is documented in the README "Getting Started" section
# (name | description | default | required). Values must not contain spaces or
# quotes: the Makefile `include`s this file directly.
# =============================================================================

# -----------------------------------------------------------------------------
# Compose
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=clarios-energy

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=clarios-energy
# local | ci | staging | production
APP_ENV=local
APP_DEBUG=true
APP_VERSION=0.1.0

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO
# console (human-readable, local) | json (machine-readable, deployed)
LOG_FORMAT=console
LOG_CONFIG_FILE=config/logging.yaml

# -----------------------------------------------------------------------------
# Database (PostgreSQL 16 + TimescaleDB)
# -----------------------------------------------------------------------------
POSTGRES_USER=energy
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=energy
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Full SQLAlchemy DSN. Leave unset to have it assembled from the parts above.
# Host-side tooling (CI, testcontainers) overrides this with localhost.
DATABASE_URL=postgresql+psycopg://energy:change-me-local-only@db:5432/energy
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2
API_ROOT_PATH=/api
API_CORS_ORIGINS=http://localhost
# Signing key for API tokens. Generate with: openssl rand -hex 32
API_SECRET_KEY=change-me-generate-a-real-secret
API_KEY_HEADER=X-API-Key

# -----------------------------------------------------------------------------
# Dashboards (Plotly Dash)
# -----------------------------------------------------------------------------
DASH_HOST=0.0.0.0
DASH_PORT=8050
# Read only when Dash runs outside the compose stack. In the stack the path is
# fixed to /dash/ by docker-compose.yml, because the Caddyfile routes it there.
DASH_URL_BASE_PATHNAME=/

# -----------------------------------------------------------------------------
# Object storage (MinIO, S3-compatible)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-local
MINIO_ENDPOINT=minio:9000
MINIO_REGION=us-east-1
MINIO_SECURE=false
MINIO_BUCKET_BRONZE=bronze-raw
MINIO_BUCKET_REPORTS=reports

# Where the Bronze loader archives the original source files before parsing
# them. `minio` is the deployed behaviour. `local` writes the same bucket/key
# layout under ARCHIVE_DIR, for a load run from a machine that cannot reach
# MinIO (the compose stack publishes no MinIO port).
ARCHIVE_BACKEND=minio
ARCHIVE_DIR=data/bronze_archive

# -----------------------------------------------------------------------------
# Equivalent batteries (EQUS) Gold
# -----------------------------------------------------------------------------
# Data-quality check 6 flags a driver whose monthly quantity moved more than this
# fraction against the month before.
EQUS_VARIATION_THRESHOLD=0.30
# How long refresh-gold or close-month waits for another one to finish before it
# gives up with exit code 3.
EQUS_LOCK_TIMEOUT_SECONDS=600
# Presentation only: the time zone of `generado_en` in the date-range report.
EQUS_TIMEZONE=America/Bogota

# -----------------------------------------------------------------------------
# Power BI: the read-only reporting login and the bridge port
# -----------------------------------------------------------------------------
# `make powerbi` creates this login (or renews its password) and opens the port.
# The login reads the views of schema `reporting` and nothing else.
REPORTING_DB_USER=powerbi
# Required by `make powerbi`. Choose your own; it is what Power BI asks for.
REPORTING_DB_PASSWORD=change-me-powerbi
# Where the bridge listens. The database speaks no TLS: keep 127.0.0.1 unless the
# network between Power BI and this machine is trusted.
# The on-premises data gateway that feeds the published report dials
# 127.0.0.1:5433, so changing this address or the port below stops its
# refreshes (docs/powerbi.md).
REPORTING_BIND_ADDRESS=127.0.0.1
# 5433 rather than 5432, which a local PostgreSQL often holds.
REPORTING_PORT=5433

# -----------------------------------------------------------------------------
# Orchestration (Prefect 3)
# -----------------------------------------------------------------------------
PREFECT_API_URL=http://prefect-server:4200/api
PREFECT_SERVER_API_HOST=0.0.0.0
PREFECT_SERVER_API_PORT=4200
PREFECT_WORK_POOL=energy-pool

# -----------------------------------------------------------------------------
# Reverse proxy (Caddy) - the only service that publishes ports
# -----------------------------------------------------------------------------
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443
CADDY_DOMAIN=localhost

# -----------------------------------------------------------------------------
# Data platform behaviour
# -----------------------------------------------------------------------------
# Canonical grid all Silver data is resampled onto. Always UTC.
CANONICAL_TIMEZONE=UTC
CANONICAL_GRID_FREQUENCY=1h
# /ready reports degraded when the newest Silver row is older than this.
DATA_FRESHNESS_MAX_LAG_HOURS=6
# Directory holding kpis.yaml, sources.yaml, equivalent_units.yaml.
CONFIG_DIR=config

# -----------------------------------------------------------------------------
# Microsoft Entra ID (sign-in)
# -----------------------------------------------------------------------------
# The app registration users sign in through (docs/sign-in.md). Copy the values
# from the Entra admin center: Overview shows the tenant and client IDs.
#
# The API reads the two IDs to check the access token of every request, and
# hands them to the web app (GET /api/config). They are identifiers, not
# secrets. Left empty, the stack starts and the app says that sign-in is not
# configured.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# The Value (not the Secret ID) shown once under Certificates & secrets. Nothing
# reads it and no container receives it: the web app signs in without a secret.
ENTRA_CLIENT_SECRET=
# The redirect URI registered under the "Web" platform. Caddy keeps /auth/* out
# of the single-page app, which signs in through its own URI (/redirect.html).
ENTRA_REDIRECT_URI=http://localhost:8080/auth/callback

# -----------------------------------------------------------------------------
# Power BI: the report the dashboard shows
# -----------------------------------------------------------------------------
# The published report the web app embeds (docs/powerbi.md). Copy both from the
# report's address in the Power BI Service:
#   https://app.powerbi.com/groups/<workspace ID>/reports/<report ID>/...
#
# The API hands them to the web app (GET /api/config), which loads the report
# with the signed-in user's own token. They are identifiers, not secrets. Left
# empty, the stack starts and the dashboard says that the report is not
# configured.
POWERBI_WORKSPACE_ID=
POWERBI_REPORT_ID=

# -----------------------------------------------------------------------------
# Chat assistant (docs/chatbot-plan.md)
# -----------------------------------------------------------------------------
# The OpenAI key of the assistant. A secret: it reaches no log and no browser.
# Left empty, the stack starts and the assistant says it is not configured.
CHAT_API_KEY=
# The OpenAI model the assistant asks.
CHAT_MODEL=gpt-4.1-mini
# How many earlier messages of a conversation go with each question.
CHAT_CONTEXT_WINDOW_LIMIT=20
# How long one answer may take, in seconds.
CHAT_TIMEOUT_SECONDS=60
# Another file of instructions for the assistant. Empty: the packaged one,
# src/energy/adapters/prompts/system_prompt.txt.
CHAT_SYSTEM_PROMPT_FILE=
